---
import Layout from '@/layouts/Layout.astro';
import Pager from '@/components/common/Pager.astro';
import PostList from '@/components/list/PostList.astro';
import { sortedPosts } from '@/utils/data';
import { PAGE_SIZE } from '@/utils/pagination';
import { intro } from '@/utils/site';

// 首页即第 1 页，每页 PAGE_SIZE 篇；第 2 页及以后由 page/[page].astro 生成
const pagePosts = sortedPosts.slice(0, PAGE_SIZE);
const totalPages = Math.ceil(sortedPosts.length / PAGE_SIZE);
---

<Layout>
  <header class="mb-10 sm:mb-14">
    <h1
      class="text-2xl sm:text-[1.875rem] font-semibold leading-snug text-base-text"
    >
      你好，我是小蜗
    </h1>
    <p class="mt-3 text-[15px] leading-relaxed text-base-text-light max-w-2xl">
      {intro}
    </p>
  </header>

  <div class="w-full">
    <PostList posts={pagePosts} />
    <Pager currentPage={1} totalPages={totalPages} />
  </div>
</Layout>
